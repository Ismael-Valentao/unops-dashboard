{
  "name": "aqi-dashboard",
  "version": "1.0.0",
  "description": "AQI Delivery Monitoring Dashboard",
  "main": "app.js",
  "scripts": {
    "start": "node --max-old-space-size=460 app.js",
    "service:diagnose": "node scripts/diagnose-services.js",
    "service:install": "node scripts/install-all-services.js",
    "service:uninstall": "node scripts/uninstall-all-services.js",
    "service:install-app": "node scripts/install-service.js",
    "service:uninstall-app": "node scripts/uninstall-service.js",
    "service:install-mysql": "node scripts/install-mysql-service.js",
    "service:uninstall-mysql": "node scripts/install-mysql-service.js --uninstall",
    "service:status": "sc query \"AQI Dashboard\" && sc query \"MySQL_AQI\"",
    "service:restart": "net stop \"AQI Dashboard\" & net start \"AQI Dashboard\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "node-windows": "^1.0.0-beta.8",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.43.0",
    "xlsx": "^0.18.5"
  }
}
