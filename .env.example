# MySQL connection - local in DEV, Hostinger in PROD
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aqi_operations

# Session secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=24

# Server
PORT=5000
NODE_ENV=development

# ── SMS (easysendsms.app) ────────────────────────────────────
# Para enviar notificações SMS aos extensionistas. Sem estas
# variáveis, o módulo SMS fica em "modo desligado" e os botões
# de envio devolvem "EASYSENDSMS_API_KEY não configurada".
# Pede a chave em https://www.easysendsms.com/account
EASYSENDSMS_API_KEY=
EASYSENDSMS_SENDER=Adicional
# Endpoint opcional. Default já aponta para a API REST.
# EASYSENDSMS_BASE_URL=https://restapi.easysendsms.app/v1/rest/sms/send
# Prefixo automático para números de 9 dígitos. MZ = 258.
SMS_DEFAULT_PREFIX=258
# Pausa entre envios em bulk (ms). 200 evita rate-limiting.
SMS_DELAY_MS=200
# Modo simulação — não chama a API, só regista no log. Útil em DEV.
# Põe a "1" para activar.
SMS_DRY_RUN=0

# ── Integração com sistema ADICIONAL (DMS Web API) ──────────
# Para puxar serviços (ADSN/GTU/destinatário/transportador) em tempo
# real via API, em vez de importar Excel manualmente.
# Sem estas variáveis, o sync fica desligado.
ADICIONAL_API_BASE=https://dmswebapi.adicional.co.mz
# Basic auth para o client_credentials (webapi:secret encoded em b64)
ADICIONAL_API_BASIC_AUTH=d2ViYXBpOnNlY3JldA==
# Credenciais do utilizador (user da empresa com permissão de ler projects)
ADICIONAL_API_USERNAME=
ADICIONAL_API_PASSWORD=
